{
  "name": "pmg-tracker-360",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"{apps,packages}/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{apps,packages}/*/src/**/*.{ts,tsx}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:check": "bun run --cwd packages/db db:check",
    "db:safety": "bun run --cwd packages/db db:safety",
    "db:status": "bun run --cwd packages/db db:status",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:studio": "bun run --cwd packages/db studio"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
